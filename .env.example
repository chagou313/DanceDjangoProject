# 复制本文件为 .env（同一目录），填入你自己的配置。.env 不会被上传到 GitHub。

# 通义千问 API Key（阿里云百炼：https://bailian.console.aliyun.com/）
QWEN_API_KEY=

# 可选：使用 MySQL 时填写
# DB_ENGINE=mysql
# DB_NAME=dance_platform
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306

# ---- 部署用（不要写进 .env，单独保存为 .env.deploy）----
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
